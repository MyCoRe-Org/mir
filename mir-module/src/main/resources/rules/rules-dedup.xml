<or xmlns:rh="https://mycore.org/rule-helper">
    <and>
        <or>
            <!-- permission checked by MCRDeDupVueServlet and the dedup REST API -->
            <action>manage-deduplication</action>
            <!-- duplicate management page, also controls the navigation entry -->
            <and>
                <target>webpage</target>
                <regex>webpage:/dedup/.*</regex>
            </and>
        </or>
        <or>
            <role>admin</role>
            <role>editor</role>
        </or>
    </and>
</or>
