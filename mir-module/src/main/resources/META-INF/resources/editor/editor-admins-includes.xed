<?xml version="1.0" encoding="ISO-8859-1"?>

<xed:template xmlns:xed="http://www.mycore.de/xeditor" xmlns:mir="http://www.mycore.de/mir">

  <xed:template id="admin.fields">
    <xed:include ref="failed-validation-messages" />

    <xed:bind xpath="../../../../service">
      <xed:include ref="status" />
    </xed:bind>

    <xed:include ref="genre" />
    <xed:include ref="toc-layout" />
    <xed:include ref="title.complex.repeated" />
    <xed:include ref="name.extended.full.repeated" />
    <xed:include ref="conference.itemsearch" />
    <xed:include ref="date.range.extended.datetimepicker" />
    <xed:include ref="place" />
    <xed:include ref="publisher" />
    <xed:include ref="creator.place" />
    <xed:include ref="creator" />
    <xed:include ref="edition" />
    <xed:include ref="extent" />
    <xed:include ref="type.of.resource" />
    <xed:include ref="language" />
    <xed:include ref="geographicAndCartographics" />
    <xed:include ref="sdnb.repeat" />
    <xed:include ref="project.repeated"/>
    <xed:include ref="identifier.managed" />
    <xed:include ref="identifier.repeated" />
    <xed:include ref="shelfmark" />
    <xed:include ref="link.repeated" />
    <xed:include ref="embargo" />
    <xed:include ref="access" />
    <xed:include ref="rights" />
    <xed:include ref="copyrightMD" />
    <xed:include ref="institutes" />
    <xed:include ref="subject.complex" />
    <xed:include ref="abstract.repeated" />
    <xed:include ref="comment.complex" />
    <xed:include ref="related.item.search.of.all.items" />
    <xed:if test="$MIR.Alias.Enabled = 'true'">
      <xed:include ref="alias" />
    </xed:if>
    <xed:include ref="related.item.other.search.of.all.items" />

    <xed:include ref="cancel.submit" />
    <xed:include ref="cleanup-rules" />
    <xed:include ref="validation-rules" />

    <xed:include ref="javascript" />
    <!-- frame for modal window -->
    <xed:include ref="modal.name" />
    <xed:include ref="modal.body" />
  </xed:template>

  <xed:template id="alias">
    <fieldset>
      <legend class="mir-fieldset-legend">
        <xed:output i18n="mir.alias" />
      </legend>
      <div class="mir-fieldset-content mir-editor-alias-container">
        <mir:textfield
          xpath="../../../../service/servflags[@class='MCRMetaLangText']/servflag[@type='alias']"
          label="mir.alias.part"
          id="mir-aliaspart"
          help-text="{i18n:mir.help.alias.part}" />
        <!-- the list is filled by editor-alias.js, the row is hidden until there are URLs -->
        <div class="mir-form-group row generated-alias-urls" hidden="hidden">
          <label class="col-md-3 col-form-label text-end form-label">
            <xed:output i18n="mir.alias.autogenerated" />
          </label>
          <div class="col-md-6">
            <ul class="list-unstyled col-form-label"></ul>
          </div>
          <div class="col-md-3">
            <a
              tabindex="0"
              class="btn btn-secondary info-button"
              role="button"
              data-bs-toggle="popover"
              data-bs-placement="right"
              data-bs-container="body"
              data-bs-trigger="focus"
              data-bs-content="{i18n:mir.help.alias.autogenerated}">
              <i class="fas fa-info"></i>
            </a>
          </div>
        </div>
      </div>
      <script type="module" src="{$WebApplicationBaseURL}js/mir/editor-alias.js" />
    </fieldset>
    <xed:cleanup-rule
      xpath="//mycoreobject/service/servflags[@class='MCRMetaLangText']/servflag[@type='alias']"
      relevant-if="string-length(normalize-space(text())) &gt; 0" />
    <xed:cleanup-rule xpath="//mycoreobject/service/servflags[@class='MCRMetaLangText']" relevant-if="servflag" />
  </xed:template>

</xed:template>
